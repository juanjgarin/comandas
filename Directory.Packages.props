<Project>
  <!--
    Central Package Management: every NuGet version is declared once, here.
    Projects reference packages WITHOUT a Version attribute: <PackageReference Include="xunit.v3" />
    Packages are added only when a PLAN.md step needs them.
    Licensing (decision D1): AwesomeAssertions instead of FluentAssertions v8+, MediatR 12.5.0, MassTransit 8.x.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Microsoft.Extensions (keep on the 10.0.x line, matching the .NET 10 runtime) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
  </ItemGroup>

  <!-- Application: in-process Mediator for CQRS. Pinned to 12.5.0, the last Apache 2.0 release (D1): do not upgrade to 13+ -->
  <ItemGroup>
    <PackageVersion Include="MediatR" Version="12.5.0" />
  </ItemGroup>

  <!-- HTTP API:.NET generates the OpenAPI document; Swagger UI only displays it (no Swashbuckle generator) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
  </ItemGroup>

  <!-- Persistence (EF Core 10.x, matching the dotnet-ef 10.0.x local tool) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
  </ItemGroup>

  <!-- Testing -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.5" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.17.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
  </ItemGroup>
</Project>
